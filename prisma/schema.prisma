generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum RequestStatus {
  NEW
  IN_REVIEW
  ACTIONED
  CLOSED
}
enum RequestType {
  ACCESS
  CORRECTION
  ERASURE
  CONSENT_WITHDRAWAL
  GRIEVANCE
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  role String @default("ADMIN")
  createdAt DateTime @default(now())
  aiUseCases AIUseCase[]
  remediationActions Remediation[]
}
model Scan {
  id String @id @default(cuid())
  sourceName String
  contentHash String
  findings Json
  createdAt DateTime @default(now())
  inventoryItems DataInventory[]
}
model DataInventory {
  id String @id @default(cuid())
  name String
  sourceType String
  classification String
  piiCount Int @default(0)
  confidence Float
  metadata Json?
  scanId String?
  scan Scan? @relation(fields:[scanId],references:[id])
  createdAt DateTime @default(now())
}
model Regulation {
  id String @id @default(cuid())
  name String
  version String
  jurisdiction String
  text String
  chunks Json
  createdAt DateTime @default(now())
  @@unique([name,version])
}
model Control {
  id String @id @default(cuid())
  code String @unique
  title String
  description String
  regulationRef String
  category String
  implemented Boolean @default(false)
  evidence Evidence[]
}
model AIUseCase {
  id String @id @default(cuid())
  name String
  model String
  purpose String
  dataSources String[]
  inputTypes String[]
  outputTypes String[]
  personalData Boolean @default(false)
  riskTier RiskTier
  riskScore Int
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id])
  createdAt DateTime @default(now())
}
model Ropa {
  id String @id @default(cuid())
  activity String
  purpose String
  legalBasis String
  dataCategories String[]
  dataSubjects String[]
  recipients String[]
  retention String
  crossBorder Boolean @default(false)
  riskTier RiskTier
  createdAt DateTime @default(now())
}
model Remediation {
  id String @id @default(cuid())
  title String
  severity RiskTier
  status String @default("OPEN")
  dueDate DateTime?
  ownerId String?
  owner User? @relation(fields:[ownerId],references:[id])
  createdAt DateTime @default(now())
}
model Evidence {
  id String @id @default(cuid())
  name String
  url String
  controlId String
  control Control @relation(fields:[controlId],references:[id])
  createdAt DateTime @default(now())
}
model DsAR {
  id String @id @default(cuid())
  requesterName String
  email String
  type RequestType
  status RequestStatus @default(NEW)
  dueAt DateTime
  auditTrail Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

